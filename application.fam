# For details & more options, see documentation/AppManifests.md in firmware repo

App(
    appid="samsungtvremote",
    name="Samsung TV Remote",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="samsung_remote_app",
    stack_size=2 * 1024,
    fap_category="Examples",
    # Optional values
    fap_version="2.0",
    fap_icon="icon.png",
    fap_description="A complete SamsungTV Remote app showcasing custom IR commands",
    fap_author="DJLeleX",
    fap_weburl="https://github.com/DJLeleX/Flipper-SamsungTVRemote",
    fap_icon_assets="images",
)
